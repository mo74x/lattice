datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}


enum ConnectionStatus {
  ACTIVE
  PAUSED
  ERROR
  REVOKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum TxKind {
  CHARGE
  REFUND
  PAYOUT
}

enum TxStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD
}

enum DriftKind {
  MISSING_EXTERNAL
  MISSING_INTERNAL
  FIELD_MISMATCH
  STALE
}

enum HealAction {
  PUSHED
  PULLED
  ESCALATED
  NONE
}

model Connection {
  id             String           @id @default(uuid())
  tenantId       String
  provider       String           // "cloudbeds_mock" | "guesty_mock"
  status         ConnectionStatus @default(ACTIVE)
  credentialsEnc String           // AES-256-GCM serialized (iv:tag:ciphertext)
  webhookSecret  String
  fieldAuthority Json             // { "status": "partner", "guestEmail": "internal" }
  syncCursor     String?
  rateLimitRps   Int              @default(5)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  externalRefs   ExternalRef[]
  rawEvents      RawEvent[]
  outboxItems    Outbox[]
  driftRecords   DriftRecord[]

  @@index([tenantId, provider])
}

model Property {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  timezone   String   @default("UTC")
  currency   String   @default("USD")
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bookings   Booking[]

  @@index([tenantId])
}

model Booking {
  id              String        @id @default(uuid())
  tenantId        String
  propertyId      String
  unitId          String        // apartment/room
  guestName       String
  guestEmail      String?
  checkIn         DateTime      @db.Date
  checkOut        DateTime      @db.Date
  status          BookingStatus @default(CONFIRMED)
  totalAmount     Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  version         Int           @default(1) // Optimistic concurrency lock
  lastWriteOrigin String        // "internal" or connectionId
  contentHash     String        // SHA-256 hash of canonical fields
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@index([tenantId, propertyId, checkIn])
  @@index([unitId, checkIn, checkOut])
}

model Transaction {
  id           String    @id @default(uuid())
  tenantId     String
  bookingId    String?
  amount       Decimal   @db.Decimal(12, 2)
  currency     String    @default("USD")
  kind         TxKind
  status       TxStatus  @default(PENDING)
  version      Int       @default(1)
  contentHash  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  booking      Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([tenantId, bookingId])
}

// Maps canonical entities to partner-specific external identifiers
model ExternalRef {
  id                    String      @id @default(uuid())
  connectionId          String
  entityType            String      // "booking" | "property" | "transaction"
  entityId              String
  externalId            String
  lastExternalHash      String?     // Echo prevention
  lastExternalUpdatedAt DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  connection            Connection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, entityType, externalId])
  @@unique([connectionId, entityType, entityId])
  @@index([entityId, entityType])
}

// Immutable raw event ingestion ledger for replay and debugging
model RawEvent {
  id              String      @id @default(uuid())
  connectionId    String
  externalEventId String
  payload         Json
  headers         Json?
  signatureValid  Boolean
  receivedAt      DateTime    @default(now())
  processedAt     DateTime?
  error           String?

  connection      Connection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalEventId])
  @@index([connectionId, processedAt])
}

// Transactional Outbox pattern
model Outbox {
  id            String       @id @default(uuid())
  aggregateType String       // "booking" | "property" | "transaction"
  aggregateId   String
  connectionId  String
  operation     String       // "UPSERT" | "CANCEL"
  payload       Json         // Canonical snapshot at mutation time
  originTag     String       // Who triggered the change (to prevent echo back)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(5)
  nextAttemptAt DateTime     @default(now())
  status        OutboxStatus @default(PENDING)
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  connection    Connection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([connectionId, status])
}

// Self-healing drift audit trail
model DriftRecord {
  id           String      @id @default(uuid())
  connectionId String
  entityType   String
  entityId     String
  kind         DriftKind
  diff         Json
  action       HealAction  @default(NONE)
  detectedAt   DateTime    @default(now())
  healedAt     DateTime?

  connection   Connection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, entityType, entityId])
  @@index([healedAt])
}

// Audit log explaining every field-level decision
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  entityType  String
  entityId    String
  origin      String
  action      String
  diff        Json
  reason      String
  createdAt   DateTime @default(now())

  @@index([tenantId, entityType, entityId])
}